Bootstrap: docker
# use ubuntu:24.04 if not needing PetSc's GPU capabilitites
# From: ubuntu:24.04
From: nvidia/cuda:12.9.1-devel-ubuntu24.04

%arguments
    FOAM_INSTALL_PATH=/usr/lib/openfoam/openfoam2112
    REPO_ROOT=/opt/bmb
    PETSC_VERSION=3.23.3
    EIGEN_VERSION=3.4.0
    BUILD_MODE=Debug

%environment
    export EIGEN_RHEO=/opt/Eigen{{ EIGEN_VERSION }}
    export PETSC_DIR=/opt/petsc-{{ PETSC_VERSION }}
    export PETSC_ARCH=arch-linux-c-opt
    export REPO_ROOT={{ REPO_ROOT }}
    export JAVA_HOME=$(dirname $(dirname $(readlink -f $(which java))))
    export PATH=${JAVA_HOME}/bin:/opt/hpcviewer:$PATH
    export LD_LIBRARY_PATH=${PETSC_DIR}/${PETSC_ARCH}/lib/:/usr/local/lib64:/usr/local/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH

%post
    # 0.0 install dependencies
    export DEBIAN_FRONTEND=noninteractive
    apt update
    apt-get -y install --no-install-recommends \
        bison \
        build-essential \
        ca-certificates \
        ccache \
        cmake \
        curl \
        flex \
        g++-13 \
        gcc-13 \
        gfortran \
        git \
        jq \
        libboost-atomic-dev \
        libboost-chrono-dev \
        libboost-date-time-dev \
        libboost-filesystem-dev \
        libboost-graph-dev \
        libboost-system-dev \
        libboost-thread-dev \
        libboost-timer-dev \
        libbz2-dev \
        libdw-dev \
        libelf-dev \
        libfl-dev \
        libiberty-dev \
        liblapack-dev \
        liblzma-dev \
        libopenblas-dev \
        libopenmpi-dev \
        libpapi-dev \
        libpfm4-dev \
        libtbb-dev \
        libunwind-dev \
        libxerces-c-dev \
        libxxhash-dev \
        libyaml-cpp-dev \
        libzstd-dev \
        make \
        mawk \
        meson \
        ninja-build \
        openjdk-21-jdk \
        openjdk-21-jre \
        pkg-config \
        python3 \
        python3-dev \
        python3-myst-parser \
        python3-venv \
        sed \
        sudo \
        vim \
        wget \
        zlib1g-dev

    git config --global user.email "you@example.com" # for patching
    git config --global user.name "Example"
    export JAVA_HOME=$(dirname $(dirname $(readlink -f $(which java))))
    export PATH=$PATH:$JAVA_HOME/bin

    # get software packages
    git clone --depth 1 --single-branch --branch=OpenFOAM-v2112 https://develop.openfoam.com/Development/openfoam {{ FOAM_INSTALL_PATH }}
    git clone https://gitlab.com/hpctoolkit/hpctoolkit /opt/hpctoolkit
    git clone --branch perf https://github.com/FoamScience/block-matrices-benchmark {{ REPO_ROOT }}
    git clone https://github.com/stefanoOliani/ICSFoam {{ REPO_ROOT }}/ICSFoam
    git clone https://github.com/fppimenta/rheoTool {{ REPO_ROOT }}/rheotool

    # set container metadata before patching
    openfoam_commit=$(git --git-dir={{ FOAM_INSTALL_PATH }}/.git rev-parse HEAD)
    hpctoolkit_commit=$(git --git-dir=/opt/hpctoolkit/.git rev-parse HEAD)
    repo_commit=$(git --git-dir={{ REPO_ROOT }}/.git rev-parse HEAD)
    ics_commit=$(git --git-dir={{ REPO_ROOT }}/ICSFoam/.git rev-parse HEAD)
    rheo_commit=$(git --git-dir={{ REPO_ROOT }}/rheotool/.git rev-parse HEAD)
    echo '{}' > /apps.json
    jq --arg app openfoam --arg commit $openfoam_commit \
        '.[$app] |= if . == null then
        {
            fork: "com-openfoam",
            branch: "OpenFOAM-v2112",
            commit: $commit,
            path: "{{ FOAM_INSTALL_PATH }}",
            version: "2112"
        }
        else . +
        {
            fork: "com-openfoam",
            branch: "OpenFOAM-v2112",
            commit: $commit,
            path: "{{ FOAM_INSTALL_PATH }}",
            version: "2112"
        } end' /apps.json > /tmp/apps.json
    mv /tmp/apps.json /apps.json
    jq --arg app hpctoolkit --arg commit $hpctoolkit_commit \
        --arg branch "2024.01.99-next" \
        '.[$app] |= if . == null then
        {
            branch: $branch,
            commit: $commit,
            source_script: "/opt/hpctoolkit/bashrc",
            version: $branch
        }
        else . +
        {
            branch: $branch,
            commit: $commit,
            source_script: "/opt/hpctoolkit/bashrc",
            version: $branch
        } end' /apps.json > /tmp/apps.json
    mv /tmp/apps.json /apps.json
    jq --arg app icsfoam --arg commit $ics_commit \
        '.[$app] |= if . == null then
        {
            branch: "master",
            path: "{{ REPO_ROOT }}/ICSFoam",
            commit: $commit
        }
        else . +
        {
            branch: "master",
            path: "{{ REPO_ROOT }}/ICSFoam",
            commit: $commit
        } end' /apps.json > /tmp/apps.json
    mv /tmp/apps.json /apps.json
    jq --arg app rheotool --arg commit $rheo_commit \
        '.[$app] |= if . == null then
        {
            branch: "master",
            path: "{{ REPO_ROOT }}/rheotool",
            commit: $commit
        }
        else . +
        {
            branch: "master",
            path: "{{ REPO_ROOT }}/rheotool",
            commit: $commit
        } end' /apps.json > /tmp/apps.json
    mv /tmp/apps.json /apps.json
    jq --arg app block-matrices-benchmark --arg commit $repo_commit \
        '.[$app] |= if . == null then
        {
            branch: "main",
            path: "{{ REPO_ROOT }}",
            commit: $commit
        }
        else . +
        {
            branch: "main",
            path: "{{ REPO_ROOT }}",
            commit: $commit
        } end' /apps.json > /tmp/apps.json
    mv /tmp/apps.json /apps.json
    # patch OpenFOAM and RheoTool
    cd {{ FOAM_INSTALL_PATH }}
    git am -3 {{ REPO_ROOT }}/patches/openfoam/0001-fix-adapt-patch-classes-for-use-with-ICSFoam.patch
    git am -3 {{ REPO_ROOT }}/patches/openfoam/0002-fix-compile-on-newer-compilers.patch
    cd {{ REPO_ROOT }}/rheotool
    git am -3 {{ REPO_ROOT }}/patches/rheotool/0001-build-update-versions.patch
    git am -3 {{ REPO_ROOT }}/patches/rheotool/0002-fix-port-sparseMatrixSolvers-to-ESI.patch
    git am -3 {{ REPO_ROOT }}/patches/rheotool/0003-build-controllable-install-paths-for-Petsc.patch
    git am -3 {{ REPO_ROOT }}/patches/rheotool/0004-fix-remove-references-to-regionCoupled-things.patch
    git am -3 {{ REPO_ROOT }}/patches/rheotool/0005-feat-flexible-Petsc-installation-with-CUDA-support.patch
    # compile OpenFOAM bits, icsFoam and rheoTool (all partially)
    /bin/bash <<'EOF'
        cd {{ FOAM_INSTALL_PATH }}
        sed -i 's/^export WM_COMPILE_OPTION=Opt/export WM_COMPILE_OPTION={{ BUILD_MODE }}/' etc/bashrc
        source etc/bashrc
        echo $WM_COMPILE_OPTION
        find ./wmake -type f -exec sed -i 's/c++11/c++14/g' {} +
        find ./wmake -type f -exec sed -i 's/-DFULLDEBUG//g' {} +
        ./wmake/src/Allmake
        cd {{ REPO_ROOT }}/rheotool/of90
        export EIGEN_RHEO=/opt/Eigen{{ EIGEN_VERSION }}
        export PETSC_DIR=/opt/petsc-{{ PETSC_VERSION }}
        export PETSC_ARCH=arch-linux-c-opt
        export LD_LIBRARY_PATH=/opt/petsc-{{ PETSC_VERSION }}/arch-linux-c-opt/lib/:$LD_LIBRARY_PATH
        ./downloadEigen /opt {{ EIGEN_VERSION }}
        ./installPetsc /opt {{ PETSC_VERSION }}
        cd {{ FOAM_INSTALL_PATH }}
        export FOAM_USER_LIBBIN=$FOAM_LIBBIN
        echo "ENVS! $FOAM_LIBBIN - $FOAM_SRC - $FOAM_USER_LIBBIN"
        ./src/Allwmake -j #|| echo "Well, that's alright ..."
        cd {{ REPO_ROOT }}/rheotool/of90
        wmake libso src/libs/fvmb
        wmake libso src/libs/sparseMatrixSolvers
        cd {{ REPO_ROOT }}/ICSFoam
        wmake libso src
EOF
    # compile hpctoolkit and get hpcviwer
    curl -L  -o /opt/hpcviewer.tgz https://gitlab.com/hpctoolkit/hpcviewer/-/releases/2024.09/downloads/hpcviewer-linux.gtk.x86_64.tgz
    tar -xvf /opt/hpcviewer.tgz -C /opt/
    rm /opt/hpcviewer.tgz
    /bin/bash << 'EOF'
    cd /opt/hpctoolkit
    git checkout 2024.01.99-next 
    mkdir -p /usr/share/meson/native
    t=/usr/share/meson/native/hpctoolkit-ci.ini
    rm -f "$t"
    echo "[built-in options]" > "$t"
    echo "wrap_mode = 'nofallback'" >> "$t"
    echo "force_fallback_for = ['libunwind', 'xed']" >> "$t"
    echo "" >> "$t"
    echo "[project options]" >> "$t"
    echo "auto_features = 'enabled'" >> "$t"
    case "$(dpkg --print-architecture)" in
      amd64) ;;
      *) echo "cuda = 'disabled'" >> "$t"; ;;
    esac
    echo "rocm = 'disabled'" >> "$t"
    echo "level0 = 'disabled'" >> "$t"
    echo "gtpin = 'disabled'" >> "$t"
    echo "" >> "$t"
    echo "[zstd:project options]" >> "$t"
    echo "lz4 = 'disabled'" >> "$t"
    cat "$t"
    meson setup builddir
    meson compile -C builddir
    meson install -C builddir
EOF

%runscript
    if [ $# -eq 0 ]; then
        /bin/bash -c "source {{ FOAM_INSTALL_PATH }}/etc/bashrc && /bin/bash --login"
    else
        /bin/bash -c "source {{ FOAM_INSTALL_PATH }}/etc/bashrc && $@"
   fi
